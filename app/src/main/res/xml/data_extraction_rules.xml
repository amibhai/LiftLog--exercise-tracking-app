<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+) Auto Backup and device-to-device transfer: workout DB + settings only. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="liftlog.db" />
        <include domain="database" path="liftlog.db-wal" />
        <include domain="file" path="datastore/settings.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="liftlog.db" />
        <include domain="database" path="liftlog.db-wal" />
        <include domain="file" path="datastore/settings.json" />
    </device-transfer>
</data-extraction-rules>
