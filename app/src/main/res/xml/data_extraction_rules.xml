<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+): workout DB + settings. Progress photos go along only when moving straight to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="liftlog.db" />
        <include domain="database" path="liftlog.db-wal" />
        <include domain="file" path="datastore/settings.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="liftlog.db" />
        <include domain="database" path="liftlog.db-wal" />
        <include domain="file" path="datastore/settings.json" />
        <include domain="file" path="progress_photos" />
    </device-transfer>
</data-extraction-rules>
